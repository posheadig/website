---
layout: base.njk
title: CV
permalink: /cv/
bodyClass: page-cv
description: Curriculum vitae of Patrick O'Shea, artist and technologist.
---
<header class="page-header">
  <h1>Curriculum Vitae</h1>
</header>

<div class="cv">
  {%- for section in cv.sections %}
  <section>
    <h2 class="section-label">{{ section.title }}</h2>
    <ul>
      {%- for item in section.items %}
      <li>
        <span class="cv-when">{{ item.when }}</span>
        <span class="cv-what">{% if item.url %}<a href="{{ item.url }}">{{ item.what }}</a>{% else %}{{ item.what }}{% endif %}{% if item.where %}<span class="cv-where">{{ item.where }}</span>{% endif %}</span>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endfor %}
</div>
