---
layout: base.njk
---
<article class="project">
  <header class="project-header">
    <p class="kicker">{{ discipline }}</p>
    <h1>{{ title }}</h1>
    {%- if summary %}<p class="lead">{{ summary | safe }}</p>{% endif %}
  </header>

  <dl class="meta">
    <div><dt>Year</dt><dd>{{ year }}</dd></div>
    {%- if role %}<div><dt>Role</dt><dd>{{ role | safe }}</dd></div>{% endif %}
    {%- if with %}<div><dt>With</dt><dd>{{ with | safe }}</dd></div>{% endif %}
    {%- if medium %}<div><dt>Medium</dt><dd>{{ medium | safe }}</dd></div>{% endif %}
    {%- if shown %}
    <div class="meta-wide"><dt>Shown</dt><dd><ul>{% for s in shown %}<li>{{ s | safe }}</li>{% endfor %}</ul></dd></div>
    {%- endif %}
    {%- if press %}
    <div class="meta-wide"><dt>Press</dt><dd><ul>{% for s in press %}<li>{{ s | safe }}</li>{% endfor %}</ul></dd></div>
    {%- endif %}
    {%- if collection %}
    <div class="meta-wide"><dt>Collections</dt><dd><ul>{% for s in collection %}<li>{{ s | safe }}</li>{% endfor %}</ul></dd></div>
    {%- endif %}
    {%- if links %}
    <div class="meta-wide"><dt>Links</dt><dd><ul class="inline">{% for l in links %}<li><a href="{{ l.url }}" rel="noopener">{{ l.label }}</a></li>{% endfor %}</ul></dd></div>
    {%- endif %}
  </dl>

  <div class="prose">
    {{ content | safe }}
  </div>

  {%- set prev = collections.projects | getPreviousCollectionItem(page) %}
  {%- set next = collections.projects | getNextCollectionItem(page) %}
  <nav class="pager" aria-label="More work">
    {%- if prev %}<a href="{{ prev.url }}" rel="prev"><span>Previous</span>{{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
    {%- if next %}<a href="{{ next.url }}" rel="next"><span>Next</span>{{ next.data.title }}</a>{% endif %}
  </nav>
</article>
